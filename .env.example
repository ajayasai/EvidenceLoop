# The Windows bootstrap writes a private .env; never commit credentials.
DATABASE_URL=postgresql://evidenceloop_app:CHANGE_ME@127.0.0.1:15432/evidenceloop
# Separate local tokens, generated by bootstrap; neither confers clinical qualification.
REVIEWER_TOKEN=
EDITOR_TOKEN=
# Optional path to an independently verified reviewer registry. Disabled by default.
EVIDENCELOOP_REVIEW_ACCESS_FILE=
# No live model or remote paid endpoint is enabled by default.
EVIDENCELOOP_LIVE_ENABLED=false
EVIDENCELOOP_ALIGNMENT_ENABLED=false
EVIDENCELOOP_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EVIDENCELOOP_MODEL=gemini-3.8-flash
EVIDENCELOOP_MODEL_API_KEY=
# Unqualified candidate only; service availability and model quality remain pending.
# Required nullable extraction slots; low reasoning; temperature omitted.
EVIDENCELOOP_REASONING_EFFORT=low
EVIDENCELOOP_TEMPERATURE=none
EVIDENCELOOP_FREE_BUDGET_VERIFIED=false
EVIDENCELOOP_BILLING_DISABLED=false
EVIDENCELOOP_SCHEMA_VERIFIED=false
EVIDENCELOOP_FREE_VERIFICATION=
EVIDENCELOOP_MAX_MODEL_REQUESTS=0
# Optional process-local rolling dispatch cap; verify against the chosen account/model.
# Repairs and transient recovery count toward this cap. It is not a billing control.
EVIDENCELOOP_MAX_MODEL_REQUESTS_PER_MINUTE=5
