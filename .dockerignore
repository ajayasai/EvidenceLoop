# Deny by default: the Docker build context cannot contain private local data.
**
!Dockerfile
!.dockerignore
!requirements.lock.txt
!apps/
!apps/web/
!apps/web/package.json
!apps/web/package-lock.json
!apps/web/index.html
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**
!contracts/
!contracts/*.json
!contracts/*.ts
!services/
!services/**/
!services/**/*.py
!evidence/
!evidence/synthetic_nonclinical.json
!scripts/
!scripts/migrate_db.py
!scripts/deploy_entrypoint.py
**/__pycache__/**
**/*.pyc
**/.env*
**/node_modules/**
**/dist/**
**/*.test.ts
**/*.test.tsx
