  "components": {
    "schemas": {
      "AnchorImport": {
        "properties": {
          "anchor_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Anchor Id"
          },
          "start": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "End"
          },
          "quote": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 1,
            "title": "Quote"
          },
          "section": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Section"
          },
          "original_locator": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Original Locator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "anchor_id",
          "start",
          "end",
          "quote",
          "section",
          "original_locator"
        ],
        "title": "AnchorImport"
      },
      "AssessmentRequest": {
        "properties": {
          "draft_id": {
            "type": "string",
            "maxLength": 100,
            "title": "Draft Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "draft_id",
          "expected_revision"
        ],
        "title": "AssessmentRequest"
      },
      "BriefDecision": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "changes_requested",
              "rejected"
            ],
            "title": "Decision"
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Rationale"
          },
          "expected_hash": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "title": "Expected Hash"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "rationale",
          "expected_hash"
        ],
        "title": "BriefDecision"
      },
      "BriefDraft": {
        "properties": {
          "family_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Family Id"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "intended_population": {
            "type": "string",
            "const": "adults_with_type_2_diabetes",
            "title": "Intended Population"
          },
          "language": {
            "type": "string",
            "const": "en",
            "title": "Language",
            "default": "en"
          },
          "intervention_aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 1,
            "title": "Intervention Aliases"
          },
          "source_dependencies": {
            "items": {
              "$ref": "#/components/schemas/SourceDependency"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Source Dependencies"
          },
          "conclusions": {
            "items": {
              "$ref": "#/components/schemas/ReviewedConclusion"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Conclusions"
          },
          "conflicts": {
            "items": {
              "$ref": "#/components/schemas/ConflictGroup"
            },
            "type": "array",
            "maxItems": 4,
            "title": "Conflicts"
          },
          "review_due_at": {
            "type": "string",
            "maxLength": 40,
            "minLength": 20,
            "title": "Review Due At"
          },
          "quality_appraisal_label": {
            "type": "string",
            "maxLength": 300,
            "minLength": 5,
            "title": "Quality Appraisal Label"
          },
          "quality_appraisal_method": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 10,
            "title": "Quality Appraisal Method"
          },
          "professional_question": {
            "type": "string",
            "maxLength": 600,
            "minLength": 10,
            "title": "Professional Question"
          },
          "scope_note": {
            "type": "string",
            "maxLength": 1500,
            "minLength": 20,
            "title": "Scope Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "family_id",
          "name",
          "intended_population",
          "intervention_aliases",
          "source_dependencies",
          "conclusions",
          "review_due_at",
          "quality_appraisal_label",
          "quality_appraisal_method",
          "professional_question",
          "scope_note"
        ],
        "title": "BriefDraft"
      },
      "Capture": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Text"
          },
          "intent": {
            "$ref": "#/components/schemas/InputIntent"
          },
          "mode": {
            "type": "string",
            "enum": [
              "replay",
              "live",
              "manual"
            ],
            "title": "Mode",
            "default": "replay"
          },
          "allow_remote_processing": {
            "type": "boolean",
            "title": "Allow Remote Processing",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "Capture"
      },
      "CheckInRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "state": {
            "type": "string",
            "enum": [
              "done_self_reported",
              "deferred",
              "abandoned",
              "needs_revision"
            ],
            "title": "State"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent"
          },
          "exercise_choice": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "same",
                  "different",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Exercise Choice"
          },
          "request_reassessment": {
            "type": "boolean",
            "title": "Request Reassessment",
            "default": false
          },
