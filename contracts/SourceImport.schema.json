{
  "$defs": {
    "AnchorImport": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Anchor Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "section": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "original_locator": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Original Locator",
          "type": "string"
        }
      },
      "required": [
        "anchor_id",
        "start",
        "end",
        "quote",
        "section",
        "original_locator"
      ],
      "title": "AnchorImport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Source Id",
      "type": "string"
    },
    "previous_version_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Version Id"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "publisher": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Publisher",
      "type": "string"
    },
    "canonical_url": {
      "maxLength": 1000,
      "minLength": 8,
      "title": "Canonical Url",
      "type": "string"
    },
    "source_date": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Date"
    },
    "source_type": {
      "enum": [
        "guideline",
        "systematic_review",
        "trial",
        "observational",
        "official_information"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "language": {
      "const": "en",
      "default": "en",
      "title": "Language",
      "type": "string"
    },
    "text": {
      "maxLength": 16000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "licensing_note": {
      "maxLength": 1000,
      "minLength": 10,
      "title": "Licensing Note",
      "type": "string"
    },
    "storage_permission": {
      "enum": [
        "permission_granted",
        "public_domain",
        "licensed_short_excerpt"
      ],
      "title": "Storage Permission",
      "type": "string"
    },
    "permission_reference": {
      "maxLength": 1000,
      "minLength": 5,
      "title": "Permission Reference",
      "type": "string"
    },
    "permission_attested": {
      "const": true,
      "title": "Permission Attested",
      "type": "boolean"
    },
    "snapshot_complete": {
      "title": "Snapshot Complete",
      "type": "boolean"
    },
    "origin_group_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Origin Group Ids",
      "type": "array"
    },
    "anchors": {
      "items": {
        "$ref": "#/$defs/AnchorImport"
      },
      "maxItems": 24,
      "minItems": 1,
      "title": "Anchors",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "title",
    "publisher",
    "canonical_url",
    "source_type",
    "text",
    "licensing_note",
    "storage_permission",
    "permission_reference",
    "permission_attested",
    "snapshot_complete",
    "origin_group_ids",
    "anchors"
  ],
  "title": "SourceImport",
  "type": "object"
}
